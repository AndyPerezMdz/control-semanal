# Copia este archivo a .env.local y llena los valores de TU proyecto Supabase
# (Supabase Dashboard -> Project Settings -> API o el botón "Connect")

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Secreto del servidor para firmar la cookie de sesión de los ingenieros.
# Genera uno propio (nunca reuses este ejemplo): openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo
